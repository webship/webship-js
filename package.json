{
  "name": "webship-js",
  "version": "2.0.18",
  "description": "Webship JS automated functional testing.",
  "main": "index.js",
  "bin": {
    "init-webship-js": "./bin/init-webship.js",
    "generate-reports": "./bin/generate-reports.js"
  },
  "directories": {
    "test": "test"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "scripts": {
    "postinstall": "node ./bin/postinstall.js",
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:report": "node tests/check-report.js",
    "test:attachments": "node tests/check-attachments.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "test:dry-run": "node tests/check-dry-run.js",
    "test:api-launch-url": "node tests/check-api-launch-url.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:js-errors": "node tests/check-javascript-errors.js",
    "test:screenshots": "node tests/check-screenshots.js",
    "test:config": "node tests/check-config.js",
    "test:exit-report": "node tests/check-exit-report.js",
    "test:breakpoints": "node tests/check-breakpoints.js",
    "test:context": "node tests/check-context.js",
    "test:video": "node tests/check-video.js",
    "test:world": "node tests/check-world.js",
    "test:clock": "node tests/check-clock.js",
    "test:settle-verbs": "node tests/check-settle-verbs.js",
    "test:timers": "node tests/check-timers.js",
    "test:network-changed": "node tests/check-network-changed.js",
    "test:homepage-address": "node tests/check-homepage-address.js",
    "test:same-origin": "node tests/check-same-origin.js",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js",
    "test:assets": "node tests/check-assets.js",
    "test:examples": "node tests/check-examples.js",
    "test:packs": "node tests/check-packs.js",
    "test:paths": "node tests/check-paths.js",
    "test:time-limit": "node tests/check-time-limit.js",
    "generate-reports": "node ./bin/generate-reports.js",
    "test:scaffold": "node tests/check-scaffold.js",
    "start": "http-server examples -p 8080 -s"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/webship-js.git"
  },
  "author": "Webship.co",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webship/webship-js/issues"
  },
  "homepage": "https://github.com/webship/webship-js",
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cucumber/cucumber": "^12",
    "@cucumber/pretty-formatter": "~1",
    "@types/node": "^24.0.0",
    "@xmldom/xmldom": "^0.9.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.11.4",
    "axios": "~1",
    "cucumber-html-reporter": "^6.0.0",
    "http-server": "^14.1.1",
    "js-yaml": "^4.1.1",
    "playwright": "^1.58.2",
    "tsx": "^4.19.2",
    "typescript": "~5",
    "xpath": "~0.0.34"
  }
}
