{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Site description",
  "type": "object",
  "required": ["name", "namespace", "version", "owner", "pages"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "namespace": { "type": "string", "enum": ["production", "staging", "development"] },
    "version": { "type": "integer", "minimum": 1 },
    "owner": {
      "type": "object",
      "required": ["team", "contact"],
      "properties": {
        "team": { "type": "string" },
        "contact": { "type": "string", "format": "email" }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "cache": { "type": "boolean" },
        "languages": { "type": "array", "items": { "type": "string", "minLength": 2, "maxLength": 2 } },
        "homepage": { "type": "string" }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "path"],
        "properties": {
          "title": { "type": "string" },
          "path": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "updated": { "type": "string", "format": "date-time" },
        "revision": { "type": "integer" }
      }
    }
  }
}
