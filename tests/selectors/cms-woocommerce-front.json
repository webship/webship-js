{
  "css": {
    "modal": ".pswp.pswp--open, [role=\"dialog\"]",
    "shop loop": "ul.products",
    "product item": "ul.products li.product",
    "product link": "ul.products li.product a",
    "product title": "h2.woocommerce-loop-product__title, .product_title",
    "product price": "span.price, .price",
    "regular price": ".price del, .woocommerce-Price-amount.amount del",
    "sale price": ".price ins, .woocommerce-Price-amount.amount ins",
    "add to cart button": "a.add_to_cart_button, button.single_add_to_cart_button",
    "added to cart": ".added_to_cart",
    "view cart": ".woocommerce-message a.button.wc-forward",
    "single product": ".single-product div.product",
    "single product images": ".woocommerce-product-gallery",
    "single product summary": ".summary.entry-summary",
    "quantity": "input.qty, .quantity input",
    "variations form": "form.variations_form",
    "variation select": ".variations select",
    "stock": "p.stock",
    "in stock": "p.stock.in-stock",
    "out of stock": "p.stock.out-of-stock",
    "data table": "table.shop_table",
    "cart item": "tr.cart_item",
    "cart subtotal": ".cart-subtotal",
    "cart total": ".order-total",
    "checkout form": "form.checkout",
    "checkout shipping": "#shipping_address_1, #ship-to-different-address",
    "checkout payment": "#payment",
    "place order button": "#place_order",
    "notice success": ".woocommerce-message",
    "notice error": ".woocommerce-error, .woocommerce-NoticeGroup-checkout",
    "notice info": ".woocommerce-info",
    "my account": ".woocommerce-MyAccount-content",
    "my account nav": ".woocommerce-MyAccount-navigation",
    "pagination": ".woocommerce-pagination",
    "ordering": ".woocommerce-ordering select",
    "result count": ".woocommerce-result-count",
    "review": ".comment_container, .woocommerce-Reviews",
    "rating": ".star-rating",
    "tabs": ".woocommerce-tabs",
    "tab list": ".tabs.wc-tabs",
    "active tab": ".tabs.wc-tabs li.active"
  },
  "xpath": {
    "first product": "(//ul[contains(@class,'products')]/li[contains(@class,'product')])[1]",
    "add to cart": "//a[contains(@class,'add_to_cart_button')] | //button[contains(@class,'single_add_to_cart_button')]",
    "place order": "//button[@id='place_order']"
  }
}
